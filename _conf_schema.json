{
  "基础配置": {
    "type": "object",
    "description": "服务连接、默认行为、内容字段与卡片外观",
    "items": {
      "pixivnow_url": {
        "description": "PixivNow 服务地址",
        "type": "string",
        "default": "https://pixiv.js.org",
        "hint": "不含末尾斜杠，例如 https://pixivnow.example.com",
        "obvious_hint": true
      },
      "token": {
        "description": "Pixiv 登录 Cookie PHPSESSID（可选）",
        "type": "string",
        "default": "",
        "hint": "用于排行榜、R18 和登录用户功能，请注意保护敏感信息",
        "obvious_hint": true
      },
      "access_key": {
        "description": "私有部署访问密钥（可选）",
        "type": "string",
        "default": "",
        "hint": "作为 X-Access-Key 请求头发送，仅自建实例开启访问控制时需要",
        "obvious_hint": false
      },
      "default_mode": {
        "description": "默认内容模式",
        "type": "string",
        "default": "safe",
        "options": ["safe", "all", "r18"],
        "obvious_hint": true
      },
      "r18_enabled": {
        "description": "允许使用 R18 模式",
        "type": "bool",
        "default": false,
        "hint": "需要配置 Token，并确保 Pixiv 账号设置允许",
        "obvious_hint": true
      },
      "default_count": {
        "description": "随机插画默认张数",
        "type": "int",
        "default": 1,
        "obvious_hint": true
      },
      "keyword_random_pages": {
        "description": "关键词随机最多检查页数",
        "type": "int",
        "default": 3,
        "hint": "候选数量足够后会提前停止，实际不一定访问全部页面；范围 1-10",
        "obvious_hint": false
      },
      "caption_fields": {
        "description": "作品回复中展示的信息字段",
        "type": "list",
        "default": ["title", "artist", "id", "bookmark", "like", "tags", "link"],
        "options": ["title", "artist", "id", "bookmark", "like", "tags", "link"],
        "labels": ["标题", "画师", "作品ID", "收藏数", "喜欢数", "标签", "作品链接"],
        "render_type": "checkbox",
        "hint": "缺失的已勾选字段会按需补查一次作品详情；未勾选字段不会产生额外请求",
        "obvious_hint": true
      },
      "max_tags": {
        "description": "最多展示的标签数量",
        "type": "int",
        "default": 10,
        "obvious_hint": false
      },
      "render_theme": {
        "description": "信息卡主题",
        "type": "string",
        "default": "dark",
        "options": ["dark", "light"],
        "labels": ["暗色", "亮色"],
        "obvious_hint": true
      },
      "render_font_path": {
        "description": "信息卡字体路径（可选）",
        "type": "string",
        "default": "",
        "hint": "通常留空自动探测；Docker 中文异常时填写字体文件或目录",
        "obvious_hint": false
      }
    }
  },
  "高级配置": {
    "type": "object",
    "description": "EdgeOne 网络策略、并发限制和缓存参数，通常保持默认即可",
    "items": {
      "download_timeout": {
        "description": "网络请求超时时间（秒）",
        "type": "int",
        "default": 20,
        "obvious_hint": false
      },
      "max_concurrent_requests": {
        "description": "最大并发网络请求数",
        "type": "int",
        "default": 6,
        "hint": "范围 1-16；EdgeOne 压力较大时可降至 3-4",
        "obvious_hint": false
      },
      "http_keepalive_enabled": {
        "description": "启用 HTTP 空闲连接复用",
        "type": "bool",
        "default": false,
        "hint": "EdgeOne/Serverless 建议关闭；常驻自建服务可开启短时复用",
        "obvious_hint": false
      },
      "api_cache_ttl": {
        "description": "API 响应缓存时间（秒）",
        "type": "int",
        "default": 180,
        "hint": "设为 0 可关闭",
        "obvious_hint": false
      },
      "image_cache_ttl": {
        "description": "图片缓存时间（秒）",
        "type": "int",
        "default": 300,
        "hint": "设为 0 可关闭",
        "obvious_hint": false
      },
      "render_cache_ttl": {
        "description": "渲染图片缓存时间（秒）",
        "type": "int",
        "default": 180,
        "hint": "设为 0 可关闭",
        "obvious_hint": false
      },
      "max_memory_image_mb": {
        "description": "单张图片内存缓存上限（MB）",
        "type": "int",
        "default": 6,
        "hint": "超过上限的图片只使用临时文件缓存；0 表示禁用内存图片缓存",
        "obvious_hint": false
      }
    }
  },
  "LLM 工具": {
    "type": "object",
    "description": "LLM 工具（pixiv_keyword_random）的开关、返回方式与视觉转述模型",
    "items": {
      "llm_tool_enabled": {
        "description": "启用 LLM 工具（pixiv_keyword_random）",
        "type": "bool",
        "default": true,
        "hint": "关闭后 AI 将无法调用该工具，修改后需重启 AstrBot 生效",
        "obvious_hint": true
      },
      "llm_tool_reply_mode": {
        "description": "LLM 工具返回方式",
        "type": "string",
        "default": "with_description",
        "options": ["with_description", "image_only"],
        "labels": ["发图并转述视觉描述", "仅发图"],
        "hint": "with_description：发图后调用视觉模型转述画面描述并追加到工具结果；image_only：仅发图，工具结果只告知 LLM 已发送",
        "obvious_hint": true
      },
      "llm_tool_vision_provider": {
        "description": "视觉转述模型（提供商）",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "点击选择用于描述画面的视觉模型；不选择则使用当前会话的聊天模型",
        "obvious_hint": true
      },
      "llm_tool_vision_prompt": {
        "description": "视觉模型描述提示词",
        "type": "string",
        "default": "请用中文描述这张 Pixiv 插画的画面内容，包括主体、构图、氛围、色彩等，200 字以内。",
        "hint": "仅 with_description 模式生效；模型不支持图像输入或调用失败时自动跳过描述",
        "obvious_hint": false
      }
    }
  },
  "额外设置": {
    "type": "object",
    "description": "消息自动撤回等额外功能",
    "items": {
      "auto_recall_enabled": {
        "description": "自动撤回插件发送的消息",
        "type": "bool",
        "default": false,
        "hint": "开启后，本插件发送的消息会在设定时间后自动撤回；仅 OneBot v11 平台生效，群消息撤回需要机器人拥有管理员权限",
        "obvious_hint": true
      },
      "auto_recall_delay": {
        "description": "撤回延迟（秒）",
        "type": "int",
        "default": 60,
        "hint": "消息发送后经过该时长自动撤回；范围 3-3600",
        "obvious_hint": false
      }
    }
  }
}
